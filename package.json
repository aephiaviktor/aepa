{
  "name": "aepa",
  "version": "0.6.6",
  "description": "Aephia C4 automation desktop app.",
  "private": true,
  "type": "module",
  "main": "dist/electron/main.js",
  "scripts": {
    "atlas-kit:update": "npm update @aephia/atlas-kit && npm run atlas-kit:check",
    "atlas-kit:check": "node tools/check-atlas-kit-next.mjs",
    "prebuild": "npm run atlas-kit:update",
    "build": "tsc -p tsconfig.json",
    "dev": "npm run build && electron .",
    "start": "electron .",
    "test": "npm run build && node --test dist/test/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "release:check": "npm run atlas-kit:check && npm run typecheck && npm test"
  },
  "dependencies": {
    "@aephia/atlas-kit": "next",
    "@solana/kit": "6.10.0",
    "@staratlas/dev-sage": "0.52.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "electron": "42.7.1",
    "typescript": "5.9.3"
  }
}
