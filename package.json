{
  "name": "aepa",
  "version": "0.3.2",
  "description": "Aephia C4 automation desktop app.",
  "private": true,
  "type": "module",
  "main": "dist/electron/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "npm run build && electron .",
    "start": "electron .",
    "test": "npm run build && node --test dist/test/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aephia/atlas-kit": "0.5.0",
    "@solana/kit": "6.10.0",
    "@staratlas/dev-sage": "0.52.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "electron": "44.3.0",
    "typescript": "5.9.3"
  }
}
